# ==================================
# RESTAURANT ERP - PRODUCTION CONFIG
# ==================================

# ============
# DATABASE
# ============
# Supabase PostgreSQL connection string
# Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/[DATABASE]
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# SSL required for Supabase
DB_SSL=true

# Auto-sync schema (set to false in production after initial setup)
DB_SYNCHRONIZE=false

# ============
# JWT TOKENS
# ============
# Main JWT secret (generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_MIN_32_CHARS

# Access token expiration
JWT_EXPIRES_IN=1h

# Refresh token secret (different from JWT_SECRET)
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_SECRET_KEY

# Refresh token expiration
JWT_REFRESH_EXPIRES_IN=7d

# ============
# SERVER
# ============
# Backend port
PORT=3001

# Environment
NODE_ENV=production

# ============
# CORS
# ============
# Frontend URL (comma-separated for multiple)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ============
# FRONTEND
# ============
# Backend API URL (include /api prefix)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# ============
# OPTIONAL
# ============
# AI Service URL (if using FastAPI service)
AI_SERVICE_URL=http://localhost:8000

# Email service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File uploads
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# Redis (for caching, optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Sentry (error tracking, optional)
SENTRY_DSN=

# ============
# SECURITY
# ============
# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Session secret
SESSION_SECRET=ANOTHER_RANDOM_SECRET_FOR_SESSIONS
