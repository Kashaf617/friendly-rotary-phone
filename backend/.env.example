# Database
## Option A (recommended when password contains special chars like '@'): use discrete DB_* vars
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=restaurant_erp

## Option B: single URL (password must be URL-encoded; '@' becomes %40)
# DATABASE_URL=postgresql://postgres:password%40withAt@db.xxxxx.supabase.co:5432/postgres

# Supabase requires SSL
DB_SSL=true

# Only use synchronize=true in development / first-time setup
DB_SYNCHRONIZE=true

# Seed control
SEED_ON_START=false
SEED_FORCE=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# App
PORT=3001
NODE_ENV=development

# AI Service
AI_SERVICE_URL=http://localhost:8000

# UAE Compliance
UAE_VAT_RATE=0.05
DEFAULT_CURRENCY=AED
